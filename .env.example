# Copy to .env.local. Replace the database values with credentials for your
# existing MySQL database; do not use these placeholders as real credentials.
MYSQL_HOST=replace-with-real-database-host
MYSQL_PORT=3306
MYSQL_USER=replace-with-real-application-user
MYSQL_PASSWORD=replace-with-real-database-password
MYSQL_DATABASE=replace-with-existing-database-name
MYSQL_SSL=false

# Auth.js v5 uses AUTH_SECRET. Generate a random value; do not use this text.
# Example generator: npx auth secret
AUTH_SECRET=replace-with-generated-random-secret

# QR signing must use a different random secret (at least 32 characters).
INSPECTION_TOKEN_SECRET=replace-with-a-different-generated-random-secret

# Optional. Defaults to the request origin if omitted; set the public site URL
# when QR codes will be scanned outside the local development environment.
APP_BASE_URL=

# Optional OCR overrides. The English model is bundled with the application.
TESSERACT_LANG_PATH=
TESSERACT_CACHE_PATH=
